{
  "realm": "flowops",
  "enabled": true,
  "displayName": "FlowOps",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "sslRequired": "external",
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\":[{\"name\":\"username\",\"displayName\":\"Username\",\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"validations\":{\"length\":{\"min\":3,\"max\":255}}},{\"name\":\"email\",\"displayName\":\"Email\",\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"validations\":{\"email\":{}}},{\"name\":\"tenant_id\",\"displayName\":\"Organization ID\",\"permissions\":{\"view\":[\"admin\"],\"edit\":[\"admin\"]},\"multivalued\":false,\"validations\":{\"pattern\":{\"pattern\":\"[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}\"}}}]}"
          ]
        }
      }
    ]
  },
  "clients": [
    {
      "clientId": "flowops-console",
      "name": "FlowOps operations console",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://127.0.0.1:5173/",
        "http://localhost:5173/"
      ],
      "webOrigins": [
        "http://127.0.0.1:5173",
        "http://localhost:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://127.0.0.1:5173/##http://localhost:5173/"
      },
      "defaultClientScopes": [
        "basic",
        "profile",
        "email"
      ],
      "protocolMappers": [
        {
          "name": "flowops-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "flowops-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "trusted-tenant",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "multivalued": "false"
          }
        },
        {
          "name": "flowops-application-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "flowops_roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "usermodel.realmRoleMapping.rolePrefix": "",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ],
      "fullScopeAllowed": false
    }
  ],
  "users": [
    {
      "username": "berlin.operator",
      "enabled": true,
      "emailVerified": true,
      "email": "berlin.operator@flowops.example",
      "attributes": {
        "tenant_id": [
          "11111111-1111-4111-8111-111111111111"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "flowops_local_only",
          "temporary": false
        }
      ],
      "requiredActions": [],
      "realmRoles": [
        "flowops-operator"
      ]
    },
    {
      "username": "hamburg.operator",
      "enabled": true,
      "emailVerified": true,
      "email": "hamburg.operator@flowops.example",
      "attributes": {
        "tenant_id": [
          "22222222-2222-4222-8222-222222222222"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "flowops_local_only",
          "temporary": false
        }
      ],
      "requiredActions": [],
      "realmRoles": [
        "flowops-operator"
      ]
    },
    {
      "username": "berlin.viewer",
      "enabled": true,
      "emailVerified": true,
      "email": "berlin.viewer@flowops.example",
      "attributes": {
        "tenant_id": [
          "11111111-1111-4111-8111-111111111111"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "flowops_local_only",
          "temporary": false
        }
      ],
      "requiredActions": [],
      "realmRoles": [
        "flowops-viewer"
      ]
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "flowops-viewer",
        "description": "Read tenant records and history"
      },
      {
        "name": "flowops-operator",
        "description": "Read and modify tenant operations"
      }
    ]
  },
  "scopeMappings": [
    {
      "client": "flowops-console",
      "roles": [
        "flowops-viewer",
        "flowops-operator"
      ]
    }
  ]
}
